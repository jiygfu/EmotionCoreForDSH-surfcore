{
  "name": "@soulproject/soulcore-settings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EmotionCore (SoulCore-compatible) settings tab for DSH: memory/FTS/L2 status, capabilities, runtime paths and actions.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
